# Spotify app credentials — create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/auth/callback

# Last.fm API key — create one at https://www.last.fm/api/account/create
LASTFM_API_KEY=your_lastfm_api_key

# Where the frontend runs, used to redirect back after login
FRONTEND_URL=http://127.0.0.1:5173

# Só o servidor MCP usa (app/mcp_server.py): ele roda fora do navegador, sem
# cookie de sessão. Deixe vazio se não for usar MCP. Para gerar, com o backend
# parado: cd backend && python -m scripts.spotify_refresh_token
SPOTIFY_REFRESH_TOKEN=

# Pasta do banco SQLite (análises, tags do Last.fm, BPM do Deezer, listagens).
# Vazio = backend/.data. Em produção, aponte para um volume persistente.
DATA_DIR=

# Segredo das sessões: a chave que criptografa as sessões guardadas no banco é
# derivada dele (gere com: openssl rand -hex 32). Trocar derruba todos os logins.
SESSION_SECRET=change_me_to_a_random_secret
# Opcional: chave Fernet própria para as sessões, independente do SESSION_SECRET.
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=
# Produção (HTTPS): true. Com true, o backend não sobe com o segredo padrão.
SESSION_COOKIE_SECURE=false
# lax: frontend e backend no mesmo site. Domínios diferentes: none (exige secure).
SESSION_COOKIE_SAMESITE=lax

# Chat com IA (opcional — sem chave o resto do app funciona normalmente).
# CHAT_PROVIDER=anthropic usa o Claude; =groq usa o Groq (útil para testar de graça).
CHAT_PROVIDER=anthropic

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# https://console.groq.com/keys
GROQ_API_KEY=
# Precisa suportar tool calling. Veja os disponiveis em https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b

# true = ao abrir o app, varre as playlists que faltam no índice e no perfil.
# Deixe false (padrão): varreduras automáticas a cada visita somaram volume
# suficiente para o Spotify suspender o app por 18 horas. Com false, a varredura
# só roda pelo botão da busca ou do perfil.
AUTO_INDEX=false
